import random
import math

def generate_cities(num_cities, seed=42):
    random.seed(seed)
    return [(random.randint(0, 100), random.randint(0, 100)) for _ in range(num_cities)]

def distance(city1, city2):
    return math.hypot(city1[0] - city2[0], city1[1] - city2[1])

def distance_matrix(cities):
    n = len(cities)
    dist = [[0.0] * n for _ in range(n)]
    for i in range(n):
        for j in range(n):
            if i != j:
                dist[i][j] = distance(cities[i], cities[j])
    return dist


class AntColony:
    def __init__(self, dist_matrix, num_ants, alpha=1.0, beta=2.0, rho=0.5, Q=100.0, iterations=200):
        self.dist = dist_matrix
        self.n = len(dist_matrix)
        self.num_ants = num_ants
        self.alpha = alpha
        self.beta = beta
        self.rho = rho
        self.Q = Q
        self.iterations = iterations
        
        self.pheromone = [[1.0 / self.n] * self.n for _ in range(self.n)]
        
        self.best_path = None
        self.best_length = float('inf')
    
    def _path_length(self, path):
        total = 0.0
        for i in range(len(path) - 1):
            total += self.dist[path[i]][path[i+1]]
        total += self.dist[path[-1]][path[0]]
        return total
    
    def _select_next_city(self, current, unvisited):
        probs = []
        for city in unvisited:
            tau = self.pheromone[current][city] ** self.alpha
            eta = (1.0 / self.dist[current][city]) ** self.beta
            probs.append(tau * eta)
        
        total = sum(probs)
        if total == 0:
            return random.choice(unvisited)
        
        probs = [p / total for p in probs]
        
        r = random.random()
        cumsum = 0.0
        for i, city in enumerate(unvisited):
            cumsum += probs[i]
            if r <= cumsum:
                return city
        return unvisited[-1]
    
    def _build_path(self, start):
        path = [start]
        unvisited = set(range(self.n))
        unvisited.remove(start)
        
        while unvisited:
            current = path[-1]
            next_city = self._select_next_city(current, unvisited)
            path.append(next_city)
            unvisited.remove(next_city)
        return path
    
    def _update_pheromones(self, ants_paths, ants_lengths):
        for i in range(self.n):
            for j in range(self.n):
                self.pheromone[i][j] *= (1.0 - self.rho)
        
        for path, length in zip(ants_paths, ants_lengths):
            deposit = self.Q / length
            for i in range(len(path) - 1):
                a, b = path[i], path[i+1]
                self.pheromone[a][b] += deposit
                self.pheromone[b][a] += deposit
            
            a, b = path[-1], path[0]
            self.pheromone[a][b] += deposit
            self.pheromone[b][a] += deposit
    
    def run(self):
        for iteration in range(self.iterations):
            ants_paths = []
            ants_lengths = []
            for ant in range(self.num_ants):
                start = random.randint(0, self.n - 1)
                path = self._build_path(start)
                length = self._path_length(path)
                ants_paths.append(path)
                ants_lengths.append(length)
                
                if length < self.best_length:
                    self.best_length = length
                    self.best_path = path[:]
            
            self._update_pheromones(ants_paths, ants_lengths)
        
            if iteration % 50 == 0:
                print(f"Iter {iteration}: best length = {self.best_length:.2f}")
        
        return self.best_path, self.best_length


if __name__ == "__main__":
    num_cities = 20
    cities = generate_cities(num_cities)
    dist = distance_matrix(cities)
    aco = AntColony(
        dist_matrix=dist,
        num_ants=30,
        alpha=1.0,
        beta=3.0,
        rho=0.3,
        Q=100.0,
        iterations=200
    )
    
    best_path, best_len = aco.run()
    
    print("РЕЗУЛЬТАТ")
    print(f"Лучший маршрут: {best_path}")
    print(f"Длина маршрута: {best_len:.2f}")
